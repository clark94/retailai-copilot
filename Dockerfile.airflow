FROM apache/airflow:2.10.5-python3.11
USER airflow
COPY --chown=airflow:root requirements.txt /tmp/retail-requirements.txt
RUN pip install --no-cache-dir "pandas>=2.1,<3"
COPY --chown=airflow:root scripts/ /opt/airflow/retailai/scripts/
COPY --chown=airflow:root data/ /opt/airflow/retailai/data/
COPY --chown=airflow:root app/ /opt/airflow/retailai/app/
COPY --chown=airflow:root airflow/dags/ /opt/airflow/dags/
ENV PYTHONPATH=/opt/airflow/retailai
