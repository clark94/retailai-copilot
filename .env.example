# Copy to .env, replace the token with a long random secret. NEVER commit .env.
DEMO_API_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
DEMO_ROLE=analyst
DEMO_ALLOWED_COUNTRIES=France
DEMO_ALLOWED_BRANDS=Casanoov,Cazeboo,Sicaan
# Set both for semantic vector RAG; requires RAM and initial model download.
INSTALL_VECTOR=false
RAG_BACKEND=tfidf
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
